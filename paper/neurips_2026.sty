%% neurips_2026.sty
%% NeurIPS 2026 style file (40th Conference on Neural Information Processing Systems)
%% Adapted from the official NeurIPS 2025 style, updated for NeurIPS 2026 (Sydney)
%% \ProvidesPackage{neurips_2026}[2026-01-29 NeurIPS 2026 submission/camera-ready style]

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2026}[2026-01-29 NeurIPS 2026]

\ProcessOptions\relax

%% --- Page geometry ---
\RequirePackage[verbose=true,letterpaper]{geometry}
\geometry{
  textheight=9in,
  textwidth=5.5in,
  top=1in,
  headheight=12pt,
  headsep=25pt,
  footskip=30pt
}

%% --- Fonts ---
\RequirePackage{times}
\RequirePackage[T1]{fontenc}

%% --- Math ---
\RequirePackage{amsmath,amssymb,amsfonts}

%% --- Section formatting ---
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{0.5em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.5em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{0.5em}{}

\titlespacing{\section}{0pt}{8pt plus 2pt minus 2pt}{4pt plus 1pt minus 1pt}
\titlespacing{\subsection}{0pt}{6pt plus 2pt minus 2pt}{3pt plus 1pt minus 1pt}
\titlespacing{\subsubsection}{0pt}{4pt plus 1pt minus 1pt}{2pt plus 0pt minus 0pt}

%% --- Captions ---
\RequirePackage[font=small,labelfont=bf]{caption}
\setlength{\captionmargin}{0.5in}

%% --- Abstract ---
\renewenvironment{abstract}{%
  \centerline{\large\bf Abstract}%
  \vspace{0.5ex}%
  \begin{quote}%
}{%
  \end{quote}%
  \vskip 1ex%
}

%% --- Header/footer ---
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\small 40th Conference on Neural Information Processing Systems (NeurIPS 2026)}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}

%% --- References ---
\RequirePackage[numbers,compress,sort]{natbib}

%% --- Hyperlinks ---
\RequirePackage[colorlinks=true,citecolor=blue,urlcolor=blue,linkcolor=blue,breaklinks=true]{hyperref}

%% --- Figures / tables ---
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{multirow}
\RequirePackage{array}

%% --- Misc ---
\RequirePackage{microtype}
\RequirePackage{parskip}
\setlength{\parskip}{0pt}
\setlength{\parindent}{1.5em}

%% --- Title block ---
\newcommand{\@neuripsheader}{}
\renewcommand{\maketitle}{%
  \begin{center}%
    {\LARGE\bf \@title \par}%
    \vskip 1em%
    {\large \@author}%
  \end{center}%
  \vskip 0.5em%
  \hrule%
  \vskip 0.5em%
}
